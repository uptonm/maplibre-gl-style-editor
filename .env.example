# Optional. Without a key the editor falls back to the free MapLibre demo tiles
# basemap; a key can also be set at runtime in the app's settings.
BUN_PUBLIC_MAPTILER_API_KEY=

# Clerk fleet gate (production only). Preview/local stay public without these.
# Use pk_live / sk_live on Production; pk_test / sk_test on Preview + Development.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=https://uptonm.dev/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=https://uptonm.dev/sign-up
# Production only — shared ops org that stores gate switches.
GATES_ORG_ID=
GATES_APP_ID=maplibre-gl-style-editor
